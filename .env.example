# Hosted Microsoft SQL Server Database Credentials (SQL Server / Azure SQL / MSSQL)
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=your_secure_password
MSSQL_DATABASE=Ultimatum
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Alternative: Single Connection String URL
# DATABASE_URL=Server=localhost,1433;Database=Ultimatum;User Id=sa;Password=your_password;TrustServerCertificate=True;

# Post Scheduler Secret (for cron authorization)
SCHEDULER_SECRET=your_scheduler_secret_key

# Optional: Google AdSense / Ezoic Publisher IDs
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
