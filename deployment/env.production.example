# ==============================================================================
# ULTIMATUM PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this file to '.env.local' in the project root on your Windows server.
# ==============================================================================

# 1. Server Runtime & Port
NODE_ENV=production
PORT=3000

# 2. Microsoft SQL Server Database Configuration
# REPLACE 'REPLACE_WITH_YOUR_SQL_HOST_OR_IP' with your SQL server's IP address or hostname
MSSQL_HOST=REPLACE_WITH_YOUR_SQL_HOST_OR_IP
MSSQL_PORT=1433
MSSQL_USER=User_Ultimatum_abc
MSSQL_PASSWORD=smart@2026
MSSQL_DATABASE=Ultimatum_abc
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# (Optional: Single Connection String Alternative)
# DATABASE_URL=Server=REPLACE_WITH_YOUR_SQL_HOST_OR_IP,1433;Database=Ultimatum_abc;User Id=User_Ultimatum_abc;Password=smart@2026;Encrypt=false;TrustServerCertificate=true;

# 3. Security & Background Scheduler Secret
SCHEDULER_SECRET=ultimatum_prod_secure_secret_2026
